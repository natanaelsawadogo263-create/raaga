# ─────────────────────────────────────────────────────────────────────────────
#  Raaga — variables d'environnement
# ─────────────────────────────────────────────────────────────────────────────
#  Copiez ce fichier en `.env.local` (ignoré par git) puis renseignez les
#  valeurs réelles. Les variables `NEXT_PUBLIC_*` sont exposées au navigateur ;
#  les autres restent côté serveur.
#
#  Sur Vercel, déclarez chaque variable dans :
#     Project ▸ Settings ▸ Environment Variables
#  et cochez les environnements Preview + Production (et Development si vous
#  utilisez `vercel dev`).
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (obligatoire) ───────────────────────────────────────────────────
# URL publique de votre projet Supabase, ex : https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clé publique anonyme (Project Settings ▸ API ▸ anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Supabase admin (recommandé) ──────────────────────────────────────────────
# Service role key — UNIQUEMENT côté serveur. Permet à l'admin Raaga de gérer
# les comptes (création / suppression de livreurs) et autorise les uploads de
# pièces justificatives à l'inscription livreur.
# NE JAMAIS la committer ni l'exposer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# ── URL canonique du site (optionnel) ────────────────────────────────────────
# Utilisée pour générer des liens absolus (e-mails, OpenGraph, sitemap…).
# Sur Vercel : laissez vide en preview (Vercel injecte VERCEL_URL) ; en
# production, mettez l'URL complète, ex : https://raaga.bf
NEXT_PUBLIC_SITE_URL=

# ── APK Android natif (optionnel) ────────────────────────────────────────────
# Si vous publiez un APK hébergé ailleurs (Supabase Storage, CDN…), mettez
# l'URL HTTPS complète ici. Laissez vide pour proposer uniquement la PWA.
NEXT_PUBLIC_APK_DOWNLOAD_URL=
